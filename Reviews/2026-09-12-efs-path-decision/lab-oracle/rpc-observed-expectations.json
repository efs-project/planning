  ],
  "requiredRawObservationFields": [
    "cell id and stage id",
    "JSON-RPC request id",
    "method",
    "to address",
    "raw calldata",
    "raw return or explicit omission/error",
    "explicit block parameter",
    "separately supplied block hash or explicit UNAVAILABLE",
    "source/provenance label"
  ],
  "comparisonRules": [
    "derive selector, argument positions, and return types only from pinned public ABI declarations",
    "derive expected semantic values only from this expectation file and independently recomputed Record identities",
    "never consume candidate decoded summaries, pre/post labels, consumerChecks, pass flags, or verdict labels as answers",
    "correlate request and response by exact JSON-RPC id, never array position",
    "require exact call target, selector, arguments, and declared basis for every supported observation",
    "never infer blockHash from blockNumber",
    "missing required raw bytes yields UNKNOWN; missing public ABI/schema yields UNSUPPORTED",
    "conflicting, malformed, or transplanted bytes yield OBSERVED_MISMATCH"
  ],
  "requiredMutations": [
    "raw return byte flip",
    "selector substitution",
    "target substitution",
    "basis substitution",
    "raw return omission",
    "fake candidate decoded summary"
  ]
}
