{
  "kind": "EFS_RPC_OBSERVED_MATRIX_EXPECTATIONS",
  "version": 1,
  "standing": "experiment-only consistency expectations; not Core, SDK, ABI, Type, workflow, deployment, or proof adoption",
  "frozenBeforePacketAndAbiInspection": true,
  "source": {
    "planningCommit": "d5b4c58e74f6532d9f170d7533e177c608f9cb90",
    "oracleBoundaryBlob": "bf4aa1b90b6f7559f66a0fadb13059c95dd2bd57",
