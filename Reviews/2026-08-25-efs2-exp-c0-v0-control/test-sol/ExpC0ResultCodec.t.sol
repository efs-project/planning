pragma solidity ^0.8.30;

import {ExpC0ResultCodec} from "../src-sol/ExpC0ResultCodec.sol";

contract ExpC0ResultCodecTest {
    function testPinnedResultVectorsDecodeReencodeAndCommit() external pure {
        (bytes memory point, bytes32 pointCommitment) = _pointVector();
        (bytes memory rejected, bytes32 rejectedCommitment) = _rejectedVector();
        (bytes memory bootstrap, bytes32 bootstrapCommitment) = _bootstrapVector();
        _assertVector(point, pointCommitment);
        _assertVector(rejected, rejectedCommitment);
        _assertVector(bootstrap, bootstrapCommitment);
    }

    function testPinnedVectorsPreserveMaxUint64AndReceiptOperationUnion() external pure {
        (bytes memory pointBytes,) = _pointVector();
        ExpC0ResultCodec.ResultV0 memory point = abi.decode(pointBytes, (ExpC0ResultCodec.ResultV0));
        require(point.executionCoordinate.value == type(uint64).max, "outer uint64 narrowed");
        require(point.observerBasis.value.freshnessCoordinate == type(uint64).max, "observer uint64 narrowed");

        (bytes memory rejectedBytes,) = _rejectedVector();
        ExpC0ResultCodec.ResultV0 memory rejected = abi.decode(rejectedBytes, (ExpC0ResultCodec.ResultV0));
        ExpC0ResultCodec.MutationPayloadV0 memory rejectedMutation =
            ExpC0ResultCodec.decodeValidateCanonicalEffectMutation(rejected.payload.data, false);
        require(rejectedMutation.operationPresent, "fresh operation absent");
        require(rejectedMutation.canonicalEffectReceipt.operationPresent, "receipt operation absent");
        require(
            rejectedMutation.operationId == rejectedMutation.canonicalEffectReceipt.operationId,
            "receipt operation mismatch"
        );
        require(
            rejectedMutation.canonicalEffectReceipt.executionCoordinate == type(uint64).max, "receipt uint64 narrowed"
        );

        (bytes memory bootstrapBytes,) = _bootstrapVector();
        ExpC0ResultCodec.ResultV0 memory bootstrap = abi.decode(bootstrapBytes, (ExpC0ResultCodec.ResultV0));
        ExpC0ResultCodec.MutationPayloadV0 memory bootstrapMutation =
            ExpC0ResultCodec.decodeValidateCanonicalEffectMutation(bootstrap.payload.data, true);
        require(
            !bootstrapMutation.operationPresent && bootstrapMutation.operationId == bytes32(0), "bootstrap operation"
        );
        require(
            !bootstrapMutation.canonicalEffectReceipt.operationPresent
                && bootstrapMutation.canonicalEffectReceipt.operationId == bytes32(0),
            "bootstrap receipt operation"
        );
    }

    function testReceiptOperationOptionalRejectsHiddenOrMismatchedIdentity() external view {
        (bytes memory rejectedBytes,) = _rejectedVector();
        ExpC0ResultCodec.ResultV0 memory rejected = abi.decode(rejectedBytes, (ExpC0ResultCodec.ResultV0));
        ExpC0ResultCodec.MutationPayloadV0 memory mutation =
            abi.decode(rejected.payload.data, (ExpC0ResultCodec.MutationPayloadV0));

        mutation.canonicalEffectReceipt.operationPresent = false;
        _expectInvalid(abi.encode(mutation), false);

        mutation.canonicalEffectReceipt.operationPresent = true;
        mutation.canonicalEffectReceipt.operationId = bytes32(uint256(0x99));
        _expectInvalid(abi.encode(mutation), false);

        mutation.canonicalEffectReceipt.operationPresent = false;
        mutation.canonicalEffectReceipt.operationId = bytes32(0);
        _expectInvalid(abi.encode(mutation), false);
    }

    function testSourceObservedRequiresRootsAndUnprovenFinality() external view {
        (bytes memory pointBytes,) = _pointVector();
        ExpC0ResultCodec.ResultV0 memory point = abi.decode(pointBytes, (ExpC0ResultCodec.ResultV0));
        point.observerBasis.value.sourceKind = 3;
        point.observerBasis.value.finality = 1;
        ExpC0ResultCodec.decodeReencodeCommit(abi.encode(point));

        point.observerBasis.value.finality = 2;
        _expectInvalidResult(abi.encode(point));

        point.observerBasis.value.finality = 1;
        point.observerBasis.value.stateRoot = bytes32(0);
        _expectInvalidResult(abi.encode(point));
    }

    function validateMutation(bytes calldata encoded, bool bootstrap) external pure {
        ExpC0ResultCodec.decodeValidateCanonicalEffectMutation(encoded, bootstrap);
    }

    function validateResult(bytes calldata encoded) external pure {
        ExpC0ResultCodec.decodeReencodeCommit(encoded);
    }

    function _expectInvalid(bytes memory encoded, bool bootstrap) internal view {
        try this.validateMutation(encoded, bootstrap) {
            revert("invalid receipt operation accepted");
        } catch {}
    }

    function _expectInvalidResult(bytes memory encoded) internal view {
        try this.validateResult(encoded) {
            revert("invalid observer basis accepted");
        } catch {}
    }

    function _assertVector(bytes memory encoded, bytes32 expectedCommitment) internal pure {
        (bytes memory reencoded, bytes32 commitment) = ExpC0ResultCodec.decodeReencodeCommit(encoded);
        require(keccak256(reencoded) == keccak256(encoded), "ResultV0 reencode mismatch");
        require(commitment == expectedCommitment, "ResultV0 commitment mismatch");
    }

    // GENERATED_RESULT_VECTORS_START
    function _pointVector() internal pure returns (bytes memory, bytes32) {
        return (
            hex"",
            0x232d836cd0c943a11ec5d0fcaa76e9512afbf466844e2271c4f4d67367391620
        );
    }

    function _rejectedVector() internal pure returns (bytes memory, bytes32) {
        return (
            hex"",
            0x58ba5e764dd172ea3c745cfa9eb2b21f4cbc255a2cfb8607f85b42e45e7ab597
        );
    }

    function _bootstrapVector() internal pure returns (bytes memory, bytes32) {
        return (
            hex"",
            0x84087e2e6f60831e80d79e76104e767ec3ce047254acb2004845441a8628097f
        );
    }
    // GENERATED_RESULT_VECTORS_END
}
